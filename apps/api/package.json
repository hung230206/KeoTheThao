    "@nestjs/typeorm": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
